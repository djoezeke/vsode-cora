{
  "name": "cora-language-support",
  "private": true,
  "version": "0.1.0",
  "description": "VS Code language support for the Cora programming language.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm run compile --workspace client",
    "build:server": "npm run compile --workspace server",
    "check": "npm run typecheck --workspaces",
    "clean": "npm run clean --workspaces",
    "test": "npm run test --workspace server"
  },
  "engines": {
    "node": ">=18"
  }
}
