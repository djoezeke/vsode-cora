{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Cora extension",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": "$tsc",
      "windows": {
        "command": "npm.cmd run build"
      }
